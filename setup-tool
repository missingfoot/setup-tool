#!/usr/bin/env python3
"""Launcher for Setup Tool. Prefers an installed setuptoollib under
/usr/lib/setup-tool, falls back to a source checkout sitting next to this
script."""

import os
import sys

_INSTALLED = "/usr/lib/setup-tool"
_HERE = os.path.dirname(os.path.realpath(__file__))

if os.path.isdir(os.path.join(_INSTALLED, "setuptoollib")):
    sys.path.insert(0, _INSTALLED)
    base_dir = "/usr/share/setup-tool"
else:
    sys.path.insert(0, _HERE)
    base_dir = _HERE

from setuptoollib.app import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main(sys.argv, base_dir=base_dir))
