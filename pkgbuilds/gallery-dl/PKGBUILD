# gallery-dl - command-line downloader for image galleries and collections.
# Source:   official PyPI sdist of mikf/gallery-dl, built here.
# Verified: pinned sha256, matching the digest PyPI publishes (upstream
#           doesn't sign releases).
# Updating: bump pkgver to the latest PyPI release, then `updpkgsums`.

pkgname=gallery-dl
pkgver=1.32.13
pkgrel=1
pkgdesc='Command-line program to download image galleries and collections from several image hosting sites'
arch=('any')
url='https://github.com/mikf/gallery-dl'
license=('GPL-2.0-only')
depends=('python' 'python-requests')
makedepends=('python-build' 'python-installer' 'python-setuptools' 'python-wheel')
optdepends=('yt-dlp: HLS/DASH video downloads and ytdl integration'
            'ffmpeg: Pixiv Ugoira conversion'
            'mkvtoolnix-cli: accurate Ugoira frame timecodes'
            'python-pysocks: SOCKS proxy support'
            'python-brotli: Brotli compression support'
            'python-zstandard: Zstandard compression support'
            'python-yaml: YAML configuration file support'
            'python-secretstorage: GNOME keyring passwords for --cookies-from-browser'
            'python-psycopg: PostgreSQL archive support'
            'python-truststore: native system certificate support'
            'python-jinja: Jinja template support')
source=("https://files.pythonhosted.org/packages/source/g/gallery_dl/gallery_dl-$pkgver.tar.gz")
sha256sums=('08c9f66b4cba4a21960dc61140626c154502caa89696203a24be5a6969a692bd')

build() {
    cd "gallery_dl-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "gallery_dl-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
}
