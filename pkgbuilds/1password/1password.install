# 1Password's browser-integration helper must be setgid to its own group.
# Don't add users to this group.
_group=onepassword

_ensure_group() {
    getent group "$_group" >/dev/null || groupadd "$_group"
}

_setup_browser_helper() {
    chgrp "$_group" /opt/1Password/1Password-BrowserSupport
    chmod g+s /opt/1Password/1Password-BrowserSupport
}

pre_install()  { _ensure_group; }
pre_upgrade()  { _ensure_group; }
post_install() { _setup_browser_helper; }
post_upgrade() { _setup_browser_helper; }

post_remove() {
    getent group "$_group" >/dev/null && groupdel "$_group"
    true
}
