[Desktop Entry]
Version=1.0
Name=Zen Browser
GenericName=Web Browser
Comment=Performance oriented Firefox-based web browser
Exec=zen-browser %u
Icon=zen-browser
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=zen
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;application/pdf;x-scheme-handler/http;x-scheme-handler/https;
Actions=new-window;new-private-window;profile-manager;

[Desktop Action new-window]
Name=New Window
Exec=zen-browser --new-window %u

[Desktop Action new-private-window]
Name=New Private Window
Exec=zen-browser --private-window %u

[Desktop Action profile-manager]
Name=Open Profile Manager
Exec=zen-browser --ProfileManager
