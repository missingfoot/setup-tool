#!/usr/bin/env bash
# setup-apt - Setup Tool's app list for Ubuntu-based distros (Zorin, Mint,
# Pop!_OS, Ubuntu 24.04+). A checklist of the same apps as apps.yaml, each
# installed from the most official source available on Ubuntu, in order of
# preference: the vendor's own apt repo or .deb, the project's official PPA,
# Ubuntu's own repos, then Flathub (for apps with no maintained deb).
#
# Not covered (Arch-only or no official Ubuntu build): Ghostty, Helium, the
# My Apps PKGBUILDs (ClipCut, File Sifter, MediaConvert, figmux, Taildrop,
# Mi Gaming Box).
#
# Usage:
#   ./setup-apt              # pick apps from a checklist
#   ./setup-apt ID...        # install these apps without asking
#   ./setup-apt --list       # list app IDs
#
# Run it as yourself, not root - it uses sudo where needed.
set -uo pipefail

# id|category|name|source - one line per app, in checklist order.
APPS=(
  "sublime-text|Editors|Sublime Text 4|Sublime HQ apt repo"
  "zed|Editors|Zed|zed.dev installer (~/.local)"
  "code|Editors|VS Code|Microsoft .deb + repo"
  "1password|Utilities|1Password|1Password apt repo"
  "fsearch|Utilities|FSearch|developer's PPA"
  "qdirstat|Utilities|QDirStat|Ubuntu"
  "localsend|Utilities|LocalSend|Flathub"
  "keepassxc|Utilities|KeePassXC|developer's PPA"
  "btop|Utilities|btop|Ubuntu"
  "qbittorrent|Utilities|qBittorrent|Ubuntu"
  "mpc-qt|Media|MPC-QT|Flathub"
  "nomacs|Media|nomacs|Ubuntu"
  "smplayer|Media|SMPlayer|Ubuntu"
  "vlc|Media|VLC|Ubuntu"
  "spotify|Media|Spotify|Flathub"
  "ffmpeg|Media Tools|FFmpeg|Ubuntu"
  "yt-dlp|Media Tools|yt-dlp|official standalone build (~/.local/bin)"
  "gallery-dl|Media Tools|gallery-dl|pipx (~/.local/bin)"
  "handbrake|Media Tools|HandBrake|Ubuntu"
  "vivaldi|Browsers|Vivaldi|Vivaldi apt repo"
  "zen-browser|Browsers|Zen Browser|Flathub (1Password app integration won't work)"
  "google-chrome|Browsers|Google Chrome|Google .deb + repo"
  "falkon|Browsers|Falkon|Ubuntu"
  "thunderbird|Communication|Thunderbird|Flathub"
  "telegram|Communication|Telegram|Flathub"
  "slack|Communication|Slack|Flathub"
  "zoom|Communication|Zoom|Zoom .deb"
  "teams-for-linux|Communication|Teams|Flathub"
  "discord|Communication|Discord|Flathub"
  "signal|Communication|Signal|Signal apt repo"
  "tailscale|Networking|Tailscale|Tailscale apt repo"
  "mullvad|Networking|Mullvad VPN|Mullvad apt repo"
  "blender|Creative|Blender|Ubuntu"
  "obs-studio|Creative|OBS Studio|OBS PPA"
  "audacity|Creative|Audacity|Ubuntu"
  "gimp|Creative|GIMP 3|Flathub"
  "inkscape|Creative|Inkscape|Inkscape PPA"
  "krita|Creative|Krita|Ubuntu"
  "freecad|Creative|FreeCAD|Flathub"
  "onlyoffice|Productivity|OnlyOffice|OnlyOffice .deb"
  "remove-libreoffice|Productivity|Remove LibreOffice|uninstalls the preinstalled copy"
  "okular|Productivity|Okular|Ubuntu"
  "obsidian|Productivity|Obsidian|Flathub"
  "ms-fonts|Fonts|Microsoft Core Fonts|Ubuntu (multiverse)"
  "inter-font|Fonts|Inter|Ubuntu"
  "prismlauncher|Gaming|Prism Launcher|Flathub"
  "steam|Gaming|Steam|Valve .deb"
  "lutris|Gaming|Lutris|Flathub"
  "nodejs|Development|Node.js + npm|Ubuntu"
  "github-cli|Development|GitHub CLI|GitHub apt repo"
  "docker|Development|Docker|Docker apt repo"
  "claude-code|Development|Claude Code|claude.ai installer (~/.local)"
)

# --- What the chosen apps add up to, filled in by the plan_* functions ------
APT_PKGS=()     # repo packages
DEB_URLS=()     # vendor .debs, downloaded and installed with apt
FLATPAKS=()     # Flathub app IDs
ROOT_CMDS=()    # run with sudo after installing
USER_CMDS=()    # run as you, last
NOTES=()        # manual follow-up, printed at the end
FAILED=()

CODENAME=$(. /etc/os-release && echo "${UBUNTU_CODENAME:-${VERSION_CODENAME:-}}")
ARCH=$(dpkg --print-architecture 2>/dev/null || echo amd64)
KEYRINGS=/etc/apt/keyrings

say()  { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m  ! %s\033[0m\n' "$*" >&2; }

# repo NAME KEY_URL "deb [signed-by=@KEY@] URL SUITE COMPONENTS"
# Saves the vendor's key to /etc/apt/keyrings (as .asc or .gpg, whichever it
# is) and writes the source line with @KEY@ replaced by the key's path.
repo() {
  local name=$1 key_url=$2 line=$3 tmp key
  [[ -f /etc/apt/sources.list.d/$name.list ]] && return 0
  tmp=$(mktemp)
  if ! curl -fsSL "$key_url" -o "$tmp"; then
    warn "couldn't download the $name signing key"; FAILED+=("$name repo"); rm -f "$tmp"; return 1
  fi
  if grep -q -- '-----BEGIN PGP' "$tmp"; then key=$KEYRINGS/$name.asc; else key=$KEYRINGS/$name.gpg; fi
  sudo install -Dm644 "$tmp" "$key"
  rm -f "$tmp"
  echo "${line//@KEY@/$key}" | sudo tee "/etc/apt/sources.list.d/$name.list" >/dev/null
}

ppa() {
  sudo add-apt-repository -y -n "ppa:$1" >/dev/null || { warn "couldn't add ppa:$1"; FAILED+=("ppa:$1"); }
}

apt_pkgs() { APT_PKGS+=("$@"); }
deb_url()  { DEB_URLS+=("$1"); }
flathub()  { FLATPAKS+=("$1"); }
root_cmd() { ROOT_CMDS+=("$1"); }
user_cmd() { USER_CMDS+=("$1"); }
note()     { NOTES+=("$1"); }
preseed()  { echo "$1" | sudo debconf-set-selections; }

# --- One plan_<id> per app ---------------------------------------------------

plan_sublime-text() {
  repo sublime-text https://download.sublimetext.com/sublimehq-pub.gpg \
    "deb [signed-by=@KEY@] https://download.sublimetext.com/ apt/stable/"
  apt_pkgs sublime-text
}
plan_zed() {
  user_cmd "curl -fsSL https://zed.dev/install.sh | sh"
}
plan_code() {
  # The .deb adds Microsoft's repo itself (so updates come through apt).
  preseed "code code/add-microsoft-repo boolean true"
  deb_url "https://code.visualstudio.com/sha/download?build=stable&os=linux-deb-x64"
}
plan_1password() {
  repo 1password https://downloads.1password.com/linux/keys/1password.asc \
    "deb [arch=$ARCH signed-by=@KEY@] https://downloads.1password.com/linux/debian/$ARCH stable main"
  apt_pkgs 1password
}
plan_fsearch()     { ppa christian-boxdoerfer/fsearch-stable; apt_pkgs fsearch; }
plan_qdirstat()    { apt_pkgs qdirstat; }
plan_localsend()   { flathub org.localsend.localsend_app; }
plan_keepassxc()   { ppa phoerious/keepassxc; apt_pkgs keepassxc; }
plan_btop()        { apt_pkgs btop; }
plan_qbittorrent() { apt_pkgs qbittorrent; }
plan_mpc-qt()      { flathub io.github.mpc_qt.mpc-qt; }
plan_nomacs()      { apt_pkgs nomacs; }
plan_smplayer()    { apt_pkgs smplayer smplayer-themes; }
plan_vlc()         { apt_pkgs vlc; }
plan_spotify()     { flathub com.spotify.Client; }
plan_ffmpeg()      { apt_pkgs ffmpeg frei0r-plugins; }
plan_yt-dlp() {
  # Ubuntu's yt-dlp goes stale within weeks; the official standalone build
  # bundles its optional deps (curl_cffi etc.) and updates with `yt-dlp -U`.
  apt_pkgs ffmpeg aria2 atomicparsley rtmpdump
  user_cmd "mkdir -p ~/.local/bin && curl -fsSL https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp_linux -o ~/.local/bin/yt-dlp && chmod +x ~/.local/bin/yt-dlp"
}
plan_gallery-dl() {
  apt_pkgs pipx ffmpeg mkvtoolnix
  user_cmd "pipx install gallery-dl || pipx upgrade gallery-dl"
}
plan_handbrake()   { apt_pkgs handbrake; }
plan_vivaldi() {
  repo vivaldi-archive https://repo.vivaldi.com/archive/linux_signing_key.pub \
    "deb [arch=$ARCH signed-by=@KEY@] https://repo.vivaldi.com/archive/deb/ stable main"
  apt_pkgs vivaldi-stable
}
plan_zen-browser()   { flathub app.zen_browser.zen; }
plan_google-chrome() { deb_url https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb; }
plan_falkon()        { apt_pkgs falkon; }
plan_thunderbird()   { flathub org.mozilla.Thunderbird; }
plan_telegram()      { flathub org.telegram.desktop; }
plan_slack()         { flathub com.slack.Slack; }
plan_zoom()          { deb_url https://zoom.us/client/latest/zoom_amd64.deb; }
plan_teams-for-linux() { flathub com.github.IsmaelMartinez.teams_for_linux; }
plan_discord()       { flathub com.discordapp.Discord; }
plan_signal() {
  repo signal-xenial https://updates.signal.org/desktop/apt/keys.asc \
    "deb [arch=amd64 signed-by=@KEY@] https://updates.signal.org/desktop/apt xenial main"
  apt_pkgs signal-desktop
}
plan_tailscale() {
  repo tailscale "https://pkgs.tailscale.com/stable/ubuntu/$CODENAME.noarmor.gpg" \
    "deb [signed-by=@KEY@] https://pkgs.tailscale.com/stable/ubuntu $CODENAME main"
  apt_pkgs tailscale
  # Makes you Tailscale's operator, so login/file cp/file get need no sudo.
  root_cmd "tailscale set --operator=$USER"
  note "tailscale up                # sign in to Tailscale"
}
plan_mullvad() {
  repo mullvad https://repository.mullvad.net/deb/mullvad-keyring.asc \
    "deb [arch=$ARCH signed-by=@KEY@] https://repository.mullvad.net/deb/stable stable main"
  apt_pkgs mullvad-vpn
}
plan_blender()    { apt_pkgs blender; }
plan_obs-studio() { ppa obsproject/obs-studio; apt_pkgs obs-studio; }
plan_audacity()   { apt_pkgs audacity; }
plan_gimp()       { flathub org.gimp.GIMP; }
plan_inkscape()   { ppa inkscape.dev/stable; apt_pkgs inkscape; }
plan_krita()      { apt_pkgs krita; }
plan_freecad()    { flathub org.freecad.FreeCAD; }
plan_onlyoffice() { deb_url https://download.onlyoffice.com/install/desktop/editors/linux/onlyoffice-desktopeditors_amd64.deb; }
plan_remove-libreoffice() {
  root_cmd "if dpkg-query -W -f='\${Status}\\n' 'libreoffice*' 2>/dev/null | grep -q '^install ok'; then DEBIAN_FRONTEND=noninteractive apt-get purge -y 'libreoffice*' && apt-get autoremove -y; fi"
}
plan_okular()     { apt_pkgs okular; }
plan_obsidian()   { flathub md.obsidian.Obsidian; }
plan_ms-fonts() {
  sudo add-apt-repository -y -n multiverse >/dev/null
  preseed "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true"
  apt_pkgs ttf-mscorefonts-installer
}
plan_inter-font()    { apt_pkgs fonts-inter; }
plan_prismlauncher() { flathub org.prismlauncher.PrismLauncher; }
plan_steam() {
  # Valve's launcher .deb; the 32-bit graphics libs it asks for on first
  # run are installed up front so that prompt never appears.
  sudo dpkg --add-architecture i386
  deb_url https://cdn.akamai.steamstatic.com/client/installer/steam.deb
  apt_pkgs libgl1:i386 libgl1-mesa-dri:i386 libc6:i386
}
plan_lutris()     { flathub net.lutris.Lutris; }
plan_nodejs()     { apt_pkgs nodejs npm; }
plan_github-cli() {
  repo github-cli https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    "deb [arch=$ARCH signed-by=@KEY@] https://cli.github.com/packages stable main"
  apt_pkgs gh
  note "gh auth login               # log in to GitHub"
}
plan_docker() {
  repo docker https://download.docker.com/linux/ubuntu/gpg \
    "deb [arch=$ARCH signed-by=@KEY@] https://download.docker.com/linux/ubuntu $CODENAME stable"
  apt_pkgs docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  root_cmd "usermod -aG docker $USER"
  note "log out and back in         # so docker works without sudo"
}
plan_claude-code() {
  user_cmd "curl -fsSL https://claude.ai/install.sh | bash"
  note "claude                      # first run asks you to log in"
}

# --- Picking ---------------------------------------------------------------

app_field() { local a; for a in "${APPS[@]}"; do [[ ${a%%|*} == "$1" ]] && { cut -d'|' -f"$2" <<<"$a"; return; }; done; }

choose() {
  command -v whiptail >/dev/null || sudo apt-get install -y whiptail >/dev/null
  local items=() a id cat name src
  for a in "${APPS[@]}"; do
    IFS='|' read -r id cat name src <<<"$a"
    items+=("$id" "$(printf '%-14s %-22s %s' "$cat" "$name" "$src")" OFF)
  done
  whiptail --title "Setup Tool (apt)" --separate-output \
    --checklist "Space to tick, Enter to install:" 40 110 32 "${items[@]}" 3>&1 1>&2 2>&3
}

# --- Main -------------------------------------------------------------------

if [[ ${1:-} == --list ]]; then
  for a in "${APPS[@]}"; do IFS='|' read -r id cat name src <<<"$a"; printf '%-16s %-14s %s\n' "$id" "$cat" "$name"; done
  exit 0
fi
[[ $EUID -eq 0 ]] && { echo "Run this as yourself, not root - it uses sudo when needed." >&2; exit 1; }
command -v apt-get >/dev/null || { echo "This is for apt-based distros (Ubuntu, Zorin, Mint...)." >&2; exit 1; }
[[ -n $CODENAME ]] || { echo "Couldn't work out the Ubuntu codename from /etc/os-release." >&2; exit 1; }

if (($#)); then
  SELECTED=("$@")
else
  mapfile -t SELECTED < <(choose) || exit 0
fi
((${#SELECTED[@]})) || { echo "Nothing selected."; exit 0; }
for id in "${SELECTED[@]}"; do
  declare -F "plan_$id" >/dev/null || { echo "Unknown app: $id (see --list)" >&2; exit 1; }
done

say "Preparing (you'll be asked for your password once)"
sudo -v || exit 1
# Keep sudo alive for long runs.
while true; do sudo -n true; sleep 50; kill -0 $$ 2>/dev/null || exit; done 2>/dev/null &
export DEBIAN_FRONTEND=noninteractive
sudo apt-get update -q
sudo apt-get install -y -q curl ca-certificates gnupg software-properties-common
sudo install -dm755 "$KEYRINGS"

say "Adding sources for: ${SELECTED[*]}"
for id in "${SELECTED[@]}"; do "plan_$id"; done

if ((${#APT_PKGS[@]} + ${#DEB_URLS[@]})); then
  say "Installing packages"
  sudo apt-get update -q
  # Skip (and report) anything this release's repos don't have, rather than
  # failing the whole install over one name.
  mapfile -t APT_PKGS < <(printf '%s\n' "${APT_PKGS[@]}" | sort -u)
  avail=()
  for p in "${APT_PKGS[@]}"; do
    if [[ $(apt-cache policy "$p" 2>/dev/null) == *"Candidate: "[^\(]* ]]; then avail+=("$p"); else warn "$p isn't available on this release - skipped"; FAILED+=("$p"); fi
  done
  debs=()
  if ((${#DEB_URLS[@]})); then
    dl=$(mktemp -d); chmod 755 "$dl"
    for i in "${!DEB_URLS[@]}"; do
      f="$dl/$i.deb"
      if curl -fSL --progress-bar "${DEB_URLS[$i]}" -o "$f"; then chmod 644 "$f"; debs+=("$f"); else warn "download failed: ${DEB_URLS[$i]}"; FAILED+=("${DEB_URLS[$i]}"); fi
    done
  fi
  sudo -E apt-get install -y "${avail[@]}" "${debs[@]}" || FAILED+=("apt install")
  [[ -n ${dl:-} ]] && rm -rf "$dl"
fi

if ((${#FLATPAKS[@]})); then
  say "Installing from Flathub"
  command -v flatpak >/dev/null || sudo apt-get install -y -q flatpak
  sudo flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  sudo flatpak install -y --noninteractive flathub "${FLATPAKS[@]}" || FAILED+=("flatpak install")
fi

for c in "${ROOT_CMDS[@]}"; do sudo sh -c "$c" || FAILED+=("$c"); done

if ((${#USER_CMDS[@]})); then
  say "Installing into your home folder"
  for c in "${USER_CMDS[@]}"; do bash -c "$c" || FAILED+=("$c"); done
fi

say "Done"
if ((${#FAILED[@]})); then
  warn "These didn't work:"; printf '    %s\n' "${FAILED[@]}" >&2
fi
if ((${#NOTES[@]})); then
  echo "Next steps:"; printf '    %s\n' "${NOTES[@]}"
fi
((${#USER_CMDS[@]})) && [[ ":$PATH:" != *":$HOME/.local/bin:"* ]] && \
  echo "    (log out and back in so ~/.local/bin is on your PATH)"
exit $((${#FAILED[@]} > 0))
