# Maintainer: James <claude@jamessparkes.com>
#
# MPC-QT - a clone of Media Player Classic reimplemented in Qt.
# Source:   official mpc-qt/mpc-qt GitHub release tarball, built here.
# Verified: pinned sha256 (upstream doesn't sign releases).
# Updating: bump pkgver to the latest GitHub release, then `updpkgsums`.

pkgname=mpc-qt
pkgver=26.07
pkgrel=1
pkgdesc='A clone of Media Player Classic reimplemented in Qt'
arch=('x86_64')
url='https://github.com/mpc-qt/mpc-qt'
license=('GPL-2.0-only')
depends=('mpv' 'qt6-svg')
makedepends=('boost' 'cmake' 'qt6-tools')
optdepends=('libva-intel-driver: hardware decoding on Intel GPUs'
            'udisks2: to detect available discs')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('03cb0b02c67cab810147e5423c6f12c20d0b00b2bad200f38d117724e2ecf8e6')

build() {
    cmake -B build -S "$pkgname-$pkgver" \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DMPCQT_VERSION="$pkgver"
    cmake --build build
}

package() {
    DESTDIR="$pkgdir" cmake --install build
}
